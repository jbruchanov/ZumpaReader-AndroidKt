<?xml version="1.0" encoding="utf-8"?>
<!--
  The -v26 qualifier is load bearing, despite lint calling it redundant against minSdk 26: aapt2
  will not compile an <adaptive-icon> from an unqualified folder, and the manifest`s icon then
  fails to link. Verified - do not "tidy" this one away.

  Living in mipmap-anydpi-v26 next to the raster ic_launcher.png is what makes this work: the
  platform resolves android:icon to the adaptive icon and the PNG stays as the pre-26 fallback.
  While this only existed under roundIcon, nothing rendered it - roundIcon is honoured by API 25
  launchers alone - and every launcher instead shimmed the flat PNG onto a white plate of its own.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/black" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
