<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      All that is left of the theme. Every other attr this used to declare styled a View, and the
      Views are gone - the Compose theme in `ui/compose/theme` carries those values now, and each of
      its properties names the attr it came from.

      contextColor stays because it is read from code: MyFirebaseService wraps a ContextThemeWrapper
      around ThemeBlack to colour the notification.
    -->
    <style name="ThemeBlack" parent="AppTheme.NoActionBar">
        <item name="contextColor">@color/yellow_orange</item>
    </style>

</resources>
