<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The palette the *platform* still needs: styles.xml for the window background, the accent and
      the hint colour, ic_launcher for the adaptive icon background, theme_black for contextColor.

      Everything the app draws itself is in `ui/compose/theme/AppColorScheme.kt` instead - these are
      not duplicated there, they are the same values arrived at from the other side.
    -->
    <color name="colorAccent">@color/yellow_orange</color>

    <color name="black">#000</color>
    <color name="grey">#808080</color>
    <color name="yellow_orange">#FFA710</color>
</resources>
