<?xml version="1.0" encoding="utf-8"?>
<!--
  The -v26 qualifier is load bearing, despite lint calling it redundant against minSdk 26: aapt2
  will not compile an <adaptive-icon> from an unqualified drawable folder, and the manifest`s
  roundIcon then fails to link. Verified - do not "tidy" this one away.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/white" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" android:gravity="center"  />
</adaptive-icon>